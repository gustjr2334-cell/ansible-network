<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
    @page { size: A4 portrait; margin: 15mm; }
    body { font-family: 'NanumGothic', 'Malgun Gothic', sans-serif; font-size: 10pt; line-height: 1.4; color: #333; }
    h1 { color: #1a365d; font-size: 18pt; border-bottom: 2px solid #2b6cb0; padding-bottom: 5px; margin-bottom: 15px; }
    h2 { color: #2c5282; font-size: 13pt; margin-top: 20px; border-left: 4px solid #3182ce; padding-left: 8px; }
    table { width: 100%; border-collapse: collapse; margin-top: 8px; margin-bottom: 15px; }
    th, td { border: 1px solid #cbd5e0; padding: 6px 8px; text-align: left; font-size: 8.5pt; }
    th { background-color: #ebf8ff; color: #2c5282; font-weight: bold; }
    .badge-ok { background-color: #c6f6d5; color: #22543d; padding: 2px 6px; border-radius: 3px; font-weight: bold; }
    .badge-warn { background-color: #fed7d7; color: #9b2c2c; padding: 2px 6px; border-radius: 3px; font-weight: bold; }
    .badge-info { background-color: #e2e8f0; color: #4a5568; padding: 2px 6px; border-radius: 3px; font-weight: bold; }
    pre { background: #f7fafc; border: 1px solid #e2e8f0; padding: 6px; font-size: 7.5pt; white-space: pre-wrap; word-wrap: break-word; font-family: monospace; }
</style>
</head>
<body>

<h1>네트워크 인프라 정기 점검 보고서</h1>
<p><b>점검 일자:</b> {{ now(fmt='%Y-%m-%d %H:%M:%S') }}</p>

<h2>1. 종합 점검 현황 요약</h2>
<table>
    <thead>
        <tr>
            <th>장비명</th>
            <th>IP 주소</th>
            <th>환경 상태(Power/Fan)</th>
            <th>Err-Disable 포트</th>
            <th>EtherChannel</th>
            <th>VRRP 상태</th>
        </tr>
    </thead>
    <tbody>
        {% for dev in all_results %}
        <tr>
            <td><b>{{ dev.name }}</b></td>
            <td>{{ dev.ip }}</td>
            <td>
                {% if dev.env_status == '정상' %}<span class="badge-ok">정상</span>
                {% else %}<span class="badge-warn">{{ dev.env_status }}</span>{% endif %}
            </td>
            <td>
                {% if dev.err_int_status == '정상' %}<span class="badge-ok">정상</span>
                {% else %}<span class="badge-warn">{{ dev.err_int_status }}</span>{% endif %}
            </td>
            <td>
                {% if dev.eth_status == '정상' %}<span class="badge-ok">정상</span>
                {% else %}<span class="badge-warn">{{ dev.eth_status }}</span>{% endif %}
            </td>
            <td>
                {% if 'Master' in dev.vrrp_status or 'Backup' in dev.vrrp_status %}
                    <span class="badge-ok">{{ dev.vrrp_status }}</span>
                {% elif 'Init' in dev.vrrp_status %}
                    <span class="badge-warn">{{ dev.vrrp_status }}</span>
                {% else %}
                    <span class="badge-info">{{ dev.vrrp_status }}</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<h2>2. 장비별 상세 주요 로그 및 모니터링 수치</h2>
{% set all_results = [] %}
{% for host in ansible_play_hosts_all %}
  {% if hostvars[host].device_status is defined %}
    {% set _ = all_results.append(hostvars[host].device_status) %}
  {% else %}
    {% set _ = all_results.append({
      'name': host,
      'ip': hostvars[host].ansible_host | default(host),
      'env_status': '접속실패',
      'err_int_status': '접속실패',
      'eth_status': '접속실패',
      'vrrp_status': '접속실패',
      'raw_env': '수집실패(접속오류)',
      'raw_cpu': '수집실패(접속오류)',
      'raw_mem': '수집실패(접속오류)',
      'raw_err_int': '수집실패(접속오류)',
      'raw_vrrp': '수집실패(접속오류)'
    }) %}
  {% endif %}
{% endfor %}

</body>
</html>
